# Keep only the game folder inside Assets
main-proj/Assets/*
!main-proj/Assets/MainGame/
!main-proj/Assets/MainGame/**

# Ignore the service project and its generated files
game-builder-file-sync-proj/

# Editor and backup noise
*.bak
*.bak-*
